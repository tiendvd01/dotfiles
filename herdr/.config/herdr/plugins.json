[
  {
    "plugin_id": "worktrunk",
    "name": "Worktrunk",
    "version": "0.1.0",
    "min_herdr_version": "0.7.0",
    "description": "Switch, create, remove, or merge git worktrees via worktrunk",
    "manifest_path": "/Users/tiendvd/.dotfiles/herdr/.config/herdr/plugins/github/worktrunk-7fb519583f31/herdr-plugin.toml",
    "plugin_root": "/Users/tiendvd/.dotfiles/herdr/.config/herdr/plugins/github/worktrunk-7fb519583f31",
    "enabled": true,
    "platforms": [
      "macos",
      "linux"
    ],
    "actions": [
      {
        "id": "merge",
        "title": "Worktree: merge into the target branch",
        "contexts": [
          "workspace"
        ],
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/open.sh\" merger"
        ]
      },
      {
        "id": "merge-no-squash",
        "title": "Worktree: merge into the target branch, keeping every commit",
        "contexts": [
          "workspace"
        ],
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/open.sh\" merger-no-squash"
        ]
      },
      {
        "id": "open",
        "title": "Worktree: switch / create from default branch",
        "contexts": [
          "workspace"
        ],
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/open.sh\" picker-default"
        ]
      },
      {
        "id": "open-current",
        "title": "Worktree: switch / create from current branch",
        "contexts": [
          "workspace"
        ],
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/open.sh\" picker-current"
        ]
      },
      {
        "id": "open-with-remotes",
        "title": "Worktree: switch / create from local or remote branches",
        "contexts": [
          "workspace"
        ],
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/open.sh\" picker-with-remotes"
        ]
      },
      {
        "id": "remove",
        "title": "Worktree: remove",
        "contexts": [
          "workspace"
        ],
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/open.sh\" remover"
        ]
      }
    ],
    "panes": [
      {
        "id": "merger",
        "title": "Worktrunk — merge",
        "placement": "split",
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/merge.sh\""
        ]
      },
      {
        "id": "merger-no-squash",
        "title": "Worktrunk — merge (no squash)",
        "placement": "split",
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/merge.sh\" --no-squash"
        ]
      },
      {
        "id": "picker-current",
        "title": "Worktrunk — current branch",
        "placement": "split",
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/picker.sh\" --create-base=current"
        ]
      },
      {
        "id": "picker-default",
        "title": "Worktrunk — default branch",
        "placement": "split",
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/picker.sh\" --create-base=default"
        ]
      },
      {
        "id": "picker-with-remotes",
        "title": "Worktrunk — local and remote branches",
        "placement": "split",
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/picker.sh\" --show-with-remotes"
        ]
      },
      {
        "id": "remover",
        "title": "Worktrunk — remove",
        "placement": "split",
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/remove.sh\""
        ]
      }
    ],
